# Copier en .env et adapter. Aucune valeur secrète ne doit être commitée.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Back-pressure (protection surcharge)
RATE_LIMIT_MAX=240
RATE_LIMIT_MAX_STAFF=2400
RATE_LIMIT_MAX_IP=600
RATE_LIMIT_MAX_WS_IP=6000
RATE_LIMIT_WINDOW=1 minute

# Verrouillage du prix / délais
QUOTE_TTL_SECONDS=120
OFFER_TIMEOUT_SECONDS=15
PRESENCE_TTL_SECONDS=30
SHUTDOWN_TIMEOUT_MS=10000

# Index géo : 'memory' (dev/test, aucune infra) ou 'redis' (prod)
GEO_BACKEND=memory

# Partenariat Google Maps (optionnel). Vide = calcul interne (haversine).
GOOGLE_MAPS_API_KEY=

# Simulation de course (tracking live sans app chauffeur). false en production.
SIMULATE_RIDES=true
SIM_TICK_MS=700
SIM_ENROUTE_MS=8000
SIM_TRIP_MS=12000

# App chauffeur : secret des jetons chauffeur (distinct de la console), durée de session,
# validité du code SMS, et mode strict (jeton obligatoire sur /drivers/:id/*).
DRIVER_JWT_SECRET=orion-dev-driver-secret-change-me
DRIVER_JWT_TTL_SECONDS=2592000
DRIVER_OTP_TTL_SECONDS=300
# Non renseigné : strict en production (jeton chauffeur obligatoire sur /drivers/:id/*),
# souple en développement.
# DRIVER_AUTH_STRICT=true

# App cliente : secret des sessions client (distinct des secrets console et chauffeur)
# et durée de session (90 jours). Le compte est rattaché à un numéro vérifié par code SMS.
CLIENT_JWT_SECRET=orion-dev-client-secret-change-me
CLIENT_JWT_TTL_SECONDS=7776000
# Opérateur SMS (codes de connexion clients et chauffeurs) : console | orange | twilio.
# console = développement : aucun SMS, le code de test s'affiche dans l'app ; en production
# les connexions par code sont alors refusées.
SMS_PROVIDER=console
SMS_SENDER_NAME=ORION
# Seuls ces préfixes reçoivent des SMS (protection contre la fraude aux SMS surtaxés).
SMS_ALLOWED_PREFIXES=+225
# Orange Côte d'Ivoire (developer.orange.com, API « SMS Côte d'Ivoire »)
# ORANGE_SMS_CLIENT_ID=
# ORANGE_SMS_CLIENT_SECRET=
# ORANGE_SMS_SENDER=tel:+2250000
# Twilio (secours international)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1...
# TWILIO_MESSAGING_SERVICE_SID=
# Codes par WhatsApp (mêmes identifiants Twilio). Bac à sable : +14155238886 ;
# en production : le numéro WhatsApp Business d'ORION et son modèle « authentification » (HX…).
# TWILIO_WHATSAPP_FROM=+14155238886
# TWILIO_WHATSAPP_CONTENT_SID=
# Codes par WhatsApp, API officielle de Meta (prioritaire sur Twilio) : identifiant du numéro
# WhatsApp et jeton d'accès (app Meta → WhatsApp → API Setup), modèle « Authentification ».
# META_WHATSAPP_PHONE_ID=
# META_WHATSAPP_TOKEN=
# META_WHATSAPP_TEMPLATE=orion_code
# META_WHATSAPP_LANGUE=fr

# Revue Apple / Google (facultatif) : ce numéro reçoit toujours ce code, et lui seul.
# CLIENT_REVIEW_PHONE=+225 01 00 00 00 01
# CLIENT_REVIEW_CODE=424242

# Commission plateforme prélevée sur chaque course (0..1)
PLATFORM_COMMISSION_RATE=0.18

# CORS : origine(s) autorisée(s) pour l'app cliente ('*' en dev, sinon liste séparée par ,).
# Apps mobiles : ajouter capacitor://localhost (iPhone) et https://localhost (Android).
CORS_ORIGIN=*

# Persistance : 'memory' (volatile) ou 'sqlite' (durable, fichier local)
PERSISTENCE=memory
DB_PATH=./data/orion.db

# ORION Assurance : clé de chiffrement des dossiers de premiers secours (AES-256-GCM).
# 32 octets encodés en base64 : openssl rand -base64 32
# Ne JAMAIS la changer en production : les dossiers déjà chiffrés deviendraient illisibles.
# En développement, une clé de démonstration est dérivée automatiquement.
# MEDICAL_DATA_KEY=

# Itinéraires routiers réels (OSRM). Vide = trajet à vol d'oiseau.
OSRM_URL=https://router.project-osrm.org

# Contrôle de sécurité pendant la course (secondes après le départ, 0 = désactivé).
SAFETY_CHECKIN_SECONDS=180

# Code de synchronisation ORION (console et tableau de bord sur Windows, macOS, mobiles).
# EMPREINTE produite par : npm run code-synchro   (jamais le code lui-même)
ORION_CODE_SYNCHRO_EMPREINTE=
# true : seuls les appareils enrôlés avec ce code ouvrent la console et le tableau de bord.
APPAREILS_EXIGES=false
# Bus temps réel entre plusieurs instances du serveur (vide : une seule instance).
REDIS_URL=

# --- SECRETS OBLIGATOIRES EN PRODUCTION ---
# Le serveur refuse de démarrer en production avec les valeurs de développement (publiques,
# écrites dans le dépôt). Générer chaque secret : openssl rand -base64 48
# ADMIN_JWT_SECRET=
# DRIVER_JWT_SECRET=
# CLIENT_JWT_SECRET=
# ADMIN_TOKEN=            (24 caractères au moins)
# ADMIN_PASSWORD=         (12 caractères au moins, ou ADMIN_USERS)
# Boîtiers télématiques (véhicules de location) : jeton présenté en « Authorization: Bearer ».
# Sans lui, les remontées de position sont refusées en production.
# TELEMATIQUE_TOKEN=

# --- SÉCURITÉ GOOGLE CLOUD (facultative ; voir deploy/gcp/README.md) ---
# Secret Manager : une valeur « sm://nom » est remplacée au démarrage par le secret du même nom.
#   CLIENT_JWT_SECRET=sm://orion-client-jwt-secret
#   ADMIN_JWT_SECRET=sm://orion-admin-jwt-secret#3        (version 3)
# Sur Cloud Run, le serveur s'identifie seul. Ailleurs : GOOGLE_APPLICATION_CREDENTIALS=<fichier>.
# GCP_PROJECT_ID=
# reCAPTCHA Enterprise avant l'envoi d'un code SMS et la connexion console : off | observe | enforce
# RECAPTCHA_MODE=off
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_MIN_SCORE=0.5
# Identity Platform : accepter les jetons d'identité de Google sur POST /clients/auth/identity
# IDENTITY_PLATFORM=false
# API Gateway : compte de service de la passerelle, adresse publique du serveur, passerelle obligatoire
# GCP_GATEWAY_SERVICE_ACCOUNT=
# GCP_GATEWAY_AUDIENCE=
# GCP_GATEWAY_REQUIRED=false
# GCP_GATEWAY_EXEMPT=/health,/ws,/admin,/appareils,/share
# Relais de confiance devant le serveur (0 : aucun · Cloud Run seul : 1 · équilibreur + Cloud Run : 2)
# TRUST_PROXY_HOPS=0
