{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "_comment_admin": "Sous-domaine admin : remplacer 'admin.orion.ci' par ton vrai domaine admin dans Vercel (Domains).",
  "rewrites": [
    { "source": "/", "has": [{ "type": "host", "value": "admin.orion.ci" }], "destination": "/admin.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "admin.orion.ci" }], "destination": "/admin.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
