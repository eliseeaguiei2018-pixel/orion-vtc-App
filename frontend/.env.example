# URL de l'API backend ORION. Laisser vide pour utiliser le mode démo (données simulées).
VITE_API_URL=http://localhost:3000

# Clé Google Maps (optionnelle, service « Maps JavaScript API »). Sans clé, l'application
# affiche la carte ORION (OpenStreetMap) ; le client peut aussi coller sa propre clé dans
# Menu → Carte. Ne jamais écrire de clé dans le dépôt : la fournir à la construction.
VITE_GOOGLE_MAPS_API_KEY=

# '1' : Google Maps est la SEULE carte de l'app cliente (exige la clé ci-dessus) : ni choix
# du fond, ni carte ORION en repli. Voir scripts/construire-client-google.sh.
VITE_MAP_GOOGLE_SEUL=
