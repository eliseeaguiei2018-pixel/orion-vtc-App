<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>fr</string>
	<!-- Langues de l'app : l'App Store les affiche sur la fiche, et iOS s'en sert pour
	     choisir la langue de l'interface (y compris navigator.language dans la WebView). -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>fr</string>
		<string>en</string>
		<string>es</string>
		<string>it</string>
		<string>de</string>
		<string>ar</string>
		<string>zh-Hans</string>
		<string>ru</string>
	</array>
	<key>CFBundleDisplayName</key>
        <string>ORION Chauffeur</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- Textes affichés par iOS au moment de demander l'accès (exigés par l'App Store). -->
	<key>NSCameraUsageDescription</key>
	<string>ORION Chauffeur utilise l’appareil photo pour votre photo de profil : vos passagers vous reconnaissent à la prise en charge, et la supervision peut vous identifier si vous déclenchez une alerte SOS.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>ORION Chauffeur vous permet de choisir votre photo de profil dans votre galerie.</string>
	<!-- Position du chauffeur pendant l'utilisation de l'app : offres de course autour de lui,
	     navigation vers le client, tracé de la course et alerte SOS localisée. Pas de
	     localisation en arrière-plan (voir NATIVE.md). -->
	<key>NSFaceIDUsageDescription</key>
	<string>ORION Chauffeur utilise Face ID pour vérifier que c’est bien vous à l’ouverture de l’application. Votre visage reste dans l’iPhone : ORION reçoit seulement « reconnu » ou « non reconnu ».</string>
	<!-- Course ou service en cours : position gardée en arrière-plan (indicateur bleu d’iOS). -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>ORION Chauffeur garde votre position pendant votre service, même écran éteint ou application quittée, pour recevoir des courses et que les clients vous voient approcher.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>ORION Chauffeur utilise votre position pendant votre service pour vous proposer les courses proches, vous guider vers le client, tracer la course et localiser une alerte SOS.</string>
	<!-- Réseau local autorisé (serveur de développement) ; Internet reste en HTTPS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Aucun chiffrement propriétaire : évite le questionnaire d'export à chaque envoi. -->
	<!-- Bouton « Appeler » : tel: ouvre la fenêtre d'appel d'iOS avec le numéro composé,
	     sms: l'app Messages. Déclarés pour que l'app puisse vérifier qu'ils sont disponibles
	     (un iPad sans forfait n'a pas de téléphone). -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
		<string>telprompt</string>
		<string>sms</string>
	</array>
	<!-- Écrans ProMotion (iPhone Pro, jusqu'à 120 Hz) : sans cette clé, iOS bride les
	     animations des applications à 60 images par seconde. Le système abaisse la
	     fréquence de lui-même quand rien ne bouge (économie de batterie). -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
