{
  "name": "orion-vtc-backend",
  "version": "0.1.0",
  "description": "ORION VTC — backend de mise en relation géolocalisée, stateless et scalable",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_ENV=test tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.1.1",
    "fastify": "^5.2.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
