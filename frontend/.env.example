# URL de l'API backend ORION. Laisser vide pour utiliser le mode démo (données simulées).
VITE_API_URL=http://localhost:3000

# Clé Google Maps (optionnelle, service « Maps JavaScript API »). Sans clé, l'application
# affiche la carte ORION (OpenStreetMap) ; le client peut aussi coller sa propre clé dans
# Menu → Carte. Ne jamais écrire de clé dans le dépôt : la fournir à la construction.
# Services facultatifs de la même clé, utilisés s'ils sont activés : « Places API (New) »
# (lieux dans la recherche), « Routes API » (trajet et durée avec trafic), « Geocoding API »
# (nom de la rue d'une position).
VITE_GOOGLE_MAPS_API_KEY=

# '1' : Google Maps est la SEULE carte de l'app cliente (exige la clé ci-dessus) : ni choix
# du fond, ni carte ORION en repli. Voir scripts/construire-client-google.sh.
VITE_MAP_GOOGLE_SEUL=

# --- Sécurité Google Cloud (facultative ; voir deploy/gcp/README.md) ---
# Clé de site reCAPTCHA Enterprise : jeton joint aux demandes de code SMS et à la connexion console.
VITE_RECAPTCHA_SITE_KEY=
# Clé de l'application pour API Gateway (en-tête x-api-key de chaque appel).
VITE_ORION_API_KEY=
# Clé web Identity Platform : la vérification du numéro du client est confiée à Google.
VITE_IDENTITY_PLATFORM_KEY=
# Adresse des canaux temps réel quand l'API passe par API Gateway (ex. https://api.orion.ci).
VITE_WS_URL=
