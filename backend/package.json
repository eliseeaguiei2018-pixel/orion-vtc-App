{
  "name": "orion-vtc-backend",
  "version": "0.1.0",
  "description": "ORION VTC — backend de mise en relation géolocalisée, stateless et scalable",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "hash-password": "tsx scripts/hash-password.ts",
    "totp-secret": "tsx scripts/totp-secret.ts",
    "test": "NODE_ENV=test SIMULATE_RIDES=false tsx --test tests/**/*.test.ts",
    "test:persist": "NODE_ENV=test SIMULATE_RIDES=false PERSISTENCE=sqlite DB_PATH=./.tmp/test.db tsx --test tests/persistence.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.2.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
