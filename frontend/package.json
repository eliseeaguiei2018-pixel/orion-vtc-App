{
  "name": "orion-vtc-client",
  "version": "0.2.0",
  "description": "ORION VTC — application client (mobilité verte, Côte d'Ivoire)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:langues": "node scripts/verifier-langues-chauffeur.mjs && node scripts/verifier-langues-client.mjs",
    "build:chauffeur": "node scripts/construire-app-chauffeur.mjs",
    "cap:chauffeur:android": "node scripts/construire-app-chauffeur.mjs android",
    "cap:chauffeur:ios": "node scripts/construire-app-chauffeur.mjs ios"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "1.3.1",
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "8.2.1",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-native-biometric": "^8.9.3",
    "@capgo/capacitor-updater": "8.54.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "maplibre-gl": "6.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^5.5.4",
    "vite": "^8.1.0"
  }
}
