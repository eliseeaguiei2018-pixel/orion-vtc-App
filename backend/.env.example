# Copier en .env et adapter. Aucune valeur secrète ne doit être commitée.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Back-pressure (protection surcharge)
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# Verrouillage du prix / délais
QUOTE_TTL_SECONDS=120
OFFER_TIMEOUT_SECONDS=15
PRESENCE_TTL_SECONDS=30
SHUTDOWN_TIMEOUT_MS=10000

# Index géo : 'memory' (dev/test, aucune infra) ou 'redis' (prod)
GEO_BACKEND=memory

# Partenariat Google Maps (optionnel). Vide = calcul interne (haversine).
GOOGLE_MAPS_API_KEY=

# Simulation de course (tracking live sans app chauffeur). false en production.
SIMULATE_RIDES=true
SIM_TICK_MS=700
SIM_ENROUTE_MS=8000
SIM_TRIP_MS=12000

# App chauffeur : secret des jetons chauffeur (distinct de la console), durée de session,
# validité du code SMS, et mode strict (jeton obligatoire sur /drivers/:id/*).
DRIVER_JWT_SECRET=orion-dev-driver-secret-change-me
DRIVER_JWT_TTL_SECONDS=2592000
DRIVER_OTP_TTL_SECONDS=300
DRIVER_AUTH_STRICT=false

# App cliente : secret des sessions client (distinct des secrets console et chauffeur)
# et durée de session (90 jours). Le compte est rattaché à un numéro vérifié par code SMS.
CLIENT_JWT_SECRET=orion-dev-client-secret-change-me
CLIENT_JWT_TTL_SECONDS=7776000
# Revue Apple / Google (facultatif) : ce numéro reçoit toujours ce code, et lui seul.
# CLIENT_REVIEW_PHONE=+225 01 00 00 00 01
# CLIENT_REVIEW_CODE=424242

# Commission plateforme prélevée sur chaque course (0..1)
PLATFORM_COMMISSION_RATE=0.18

# CORS : origine(s) autorisée(s) pour l'app cliente ('*' en dev, sinon liste séparée par ,).
# Apps mobiles : ajouter capacitor://localhost (iPhone) et https://localhost (Android).
CORS_ORIGIN=*

# Persistance : 'memory' (volatile) ou 'sqlite' (durable, fichier local)
PERSISTENCE=memory
DB_PATH=./data/orion.db
